{
  "name": "opendesktop",
  "version": "0.1.0",
  "description": "An open desktop agent workspace — bring your own model.",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm smoke",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "smoke": "vite build -c vite.smoke.config.ts && OPENDESKTOP_HOME=\"$(mktemp -d)\" node out/smoke/smoke.mjs",
    "icon": "electron scripts/make-icon.cjs",
    "secrets:check": "vite build -c vite.smoke.config.ts && OPENDESKTOP_HOME=\"$(mktemp -d)\" electron out/smoke/secrets-check.mjs",
    "ui:check": "vite build -c vite.uicheck.config.ts && vite build -c vite.smoke.config.ts && electron out/smoke/ui-check.mjs",
    "local:check": "vite build -c vite.smoke.config.ts && node out/smoke/local-check.mjs",
    "mcp:check": "vite build -c vite.smoke.config.ts && node out/smoke/mcp-check.mjs",
    "live:check": "vite build -c vite.smoke.config.ts && OPENDESKTOP_HOME=\"$(mktemp -d)\" node out/smoke/live-check.mjs",
    "policy:check": "vite build -c vite.smoke.config.ts && OPENDESKTOP_HOME=\"$(mktemp -d)\" node out/smoke/policy-check.mjs",
    "web:build": "electron-vite build && vite build -c vite.server.config.ts && vite build -c vite.web.config.ts",
    "web:start": "node out/server/server.cjs"
  },
  "build": {
    "appId": "com.opendesktop.app",
    "productName": "OpenDesktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/pentest",
        "to": "pentest"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true
    },
    "npmRebuild": false,
    "dmg": {
      "title": "OpenDesktop"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.99",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.13",
    "mime": "^4.1.0",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0",
    "ws": "^8.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
